# ─── Supabase ───────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# ─── Servidor ────────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── IA (al menos una requerida para los agentes) ────────────
ANTHROPIC_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
AI_DEFAULT_MODEL=claude-opus-4-6

# ─── Research web (Analista scrape + búsqueda) — opcionales ─
# Orden: Serper → Tavily → Google CSE → DuckDuckGo lite (gratis)
SERPER_API_KEY=
TAVILY_API_KEY=
GOOGLE_CSE_API_KEY=
GOOGLE_CSE_ID=
# CRM_INTERNAL_KEY=  # para hooks /api/hooks/research y /api/hooks/perfiles-run

# ─── ManyChat (canal WA + Instagram hasta tener verificación Meta) ─
MANYCHAT_API_KEY=
MANYCHAT_WEBHOOK_SECRET=

# ─── Meta Ads (solo lectura de métricas, sin mensajería directa) ───
META_ADS_ACCESS_TOKEN=
META_ADS_ACCOUNT_ID=act_XXXXXXXXX
META_APP_SECRET=

# ─── Google Ads ──────────────────────────────────────────────
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=

# ─── LinkedIn Ads (stub lectura métricas) ────────────────────
LINKEDIN_ADS_ACCESS_TOKEN=
LINKEDIN_ADS_ACCOUNT_ID=

# ─── TikTok Ads (stub) ───────────────────────────────────────
TIKTOK_ADS_ACCESS_TOKEN=
TIKTOK_ADS_ADVERTISER_ID=

# ─── Google Analytics 4 / orgánico web (stub) ────────────────
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=

# ─── Instagram orgánico (stub Graph API) ─────────────────────
INSTAGRAM_GRAPH_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# ─── WhatsApp métricas conversación (stub; ≠ Whapi reuniones) ─
WHATSAPP_METRICS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ─── Google (Calendar + Sheets — mismo OAuth) ────────────────
CALENDAR_PROVIDER=google
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REFRESH_TOKEN=
# GOOGLE_CALENDAR_REDIRECT_URI=https://tu-dominio.com/api/auth/google-callback
# El refresh token se obtiene visitando /api/auth/google-calendar una vez

# ─── Agente 03 · Reuniones (Zoom / Meet / WhatsApp) ──────────
# LLM: Groq preferido (como Analista n8n); si falta, usa ANTHROPIC_API_KEY
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
CRM_INTERNAL_KEY=
CRM_PUBLIC_URL=https://crm-murex-tau.vercel.app

# ─── Agente 04 · Briefing ────────────────────────────────────
# Mismos LLM + CRM_INTERNAL_KEY. Hook: POST /api/hooks/briefings-run

# Zoom OAuth + webhook
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_REDIRECT_URI=https://crm-murex-tau.vercel.app/api/integrations/oauth/zoom/callback
ZOOM_WEBHOOK_SECRET=

# Google Meet OAuth (puede reutilizar GOOGLE_CALENDAR_* si no seteás estos)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_MEET_REDIRECT_URI=https://crm-murex-tau.vercel.app/api/integrations/oauth/google_meet/callback

# WhatsApp (Whapi) — NO reemplaza el webhook del SDR; solo lectura / forward selectivo
WHAPI_TOKEN=
